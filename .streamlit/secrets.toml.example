# ==============================================================
# USMAN AI GTM - SECRETS TEMPLATE EXAMPLE
# DO NOT COMMIT THE REAL secrets.toml TO VERSION CONTROL.
# Copy this file to .streamlit/secrets.toml and fill in your values.
# ==============================================================

[api_keys]
# Search & AI Intelligence Providers
SERPER_API_KEY = ""
OPENAI_API_KEY = ""
GEMINI_API_KEY = ""
GROQ_API_KEY = ""

[google_oauth]
# Google Cloud Console OAuth 2.0 Credentials (Gmail API)
# Authorized Redirect URI must match your app URL (e.g. http://localhost:8501)
GOOGLE_CLIENT_ID = ""
GOOGLE_CLIENT_SECRET = ""
GOOGLE_REDIRECT_URI = "http://localhost:8501"

[meta_whatsapp]
# Meta for Developers - WhatsApp Business Cloud API
META_APP_ID = ""
META_APP_SECRET = ""
META_REDIRECT_URI = "http://localhost:8501"

[security]
# Fernet 32-byte base64 encryption key for OAuth tokens and SMTP app tokens.
# If left blank, a safe persistent dev key will be auto-generated in data/.encryption_key
OAUTH_ENCRYPTION_KEY = ""

[database]
# Optional Persistent Production Database URL (e.g. PostgreSQL, MySQL, or persistent SQLite)
# DATABASE_URL = "postgresql://user:pass@host:5432/usman_gtm"
DATABASE_URL = ""
