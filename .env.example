# ==============================================================================
# USMAN AI GTM — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: Copy this file to '.env' and populate with your verified credentials.
# NEVER commit the actual '.env' file to version control.
# ==============================================================================

# Core Application Settings
APP_NAME="USMAN AI GTM"
ENVIRONMENT="development"             # "development" | "staging" | "production"
DEBUG=False
SECRET_KEY="generate_a_secure_random_64_character_hex_string_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440       # 24 Hours

# Host & Networking
HOST="0.0.0.0"
PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://usmanai.com,https://app.usmanai.com"
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

# Database Configuration
# Default: Local High-Performance SQLite engine
DATABASE_URL="sqlite:///./usman_data_analytics.db"
# Production PostgreSQL Example:
# DATABASE_URL="postgresql://user:password@pg-cluster.internal:5432/usman_gtm_enterprise"

# Demo Mode Configuration
ENABLE_SYNTHETIC_DEMO_DATA=True

# ==============================================================================
# MULTI-AI INTELLIGENCE PROVIDERS (29+ Engine Vault)
# ==============================================================================
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
MISTRAL_API_KEY=""
PERPLEXITY_API_KEY=""
COHERE_API_KEY=""
DEEPSEEK_API_KEY=""
ANYSCALE_API_KEY=""
TOGETHER_API_KEY=""
REPLICATE_API_KEY=""
AI21_API_KEY=""

# ==============================================================================
# SEARCH & WEB DISCOVERY PROVIDERS
# ==============================================================================
SERPER_API_KEY=""
SERPAPI_API_KEY=""
TAVILY_API_KEY=""
BING_SEARCH_API_KEY=""
SCRAPINGBEE_API_KEY=""
FIRECRAWL_API_KEY=""

# ==============================================================================
# OFFICIAL GOOGLE OAUTH 2.0 (Gmail Outreach & Sync)
# ==============================================================================
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/email/oauth/callback"

# ==============================================================================
# OFFICIAL META WHATSAPP BUSINESS PLATFORM (Cloud API)
# ==============================================================================
# Obtain from Meta Developers Portal -> WhatsApp Business App Dashboard
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_VERIFY_TOKEN="usman_gtm_webhook_verification_token_2026"

# ==============================================================================
# CRM & ENRICHMENT WEBHOOKS
# ==============================================================================
SLACK_WEBHOOK_URL=""
TEAMS_WEBHOOK_URL=""
ZAPIER_WEBHOOK_URL=""
MAKE_WEBHOOK_URL=""

# ==============================================================================
# RATE LIMITING & SECURITY
# ==============================================================================
MAX_SEARCH_LEADS_PER_REQUEST=100
MAX_EMAIL_SEND_PER_DAY_PER_INBOX=250
MAX_WHATSAPP_SEND_PER_DAY=1000
RATE_LIMIT_PER_MINUTE=60
